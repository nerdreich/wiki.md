{
  "name": "wiki.md",
  "version": "2.5.0",
  "description": "A file-based, responsive Markdown wiki, written in PHP.",
  "type": "module",
  "keywords": [
    "wiki",
    "wiki.md",
    "Markdown",
    "PHP",
    "responsive"
  ],
  "engines": {
    "npm": ">=8.0.0"
  },
  "author": "Markus Leupold-Löwenthal",
  "homepage": "https://github.com/nerdreich/wiki.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerdreich/wiki.md"
  },
  "bugs": {
    "url": "https://github.com/nerdreich/wiki.md/issues"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dist": "gulp dist",
    "package": "npm-run-all lint gulp:package package:tgz",
    "package:tgz": "tar --sort=name -C ./dist -czvf dist/wiki.md-${npm_package_version}.tar.gz wiki.md",
    "gulp": "gulp",
    "gulp:package": "gulp package",

    "lint": "npm-run-all lint:stylelint lint:js lint:phpcbf lint:phpcs",
    "lint:js": "eslint --ext .ts,.js,.cjs,.mjs",
    "lint:stylelint": "stylelint src/themes/elegant/scss",
    "lint:phpcbf": "tools/phpcbf.phar --standard=PSR12 --extensions=php --ignore=*/core/lib/* src/",
    "lint:phpcs": "tools/phpcs.phar --standard=PSR12 --extensions=php --ignore=*/core/lib/* src/",
    "fix": "run-s fix:js fix:prettier fix:stylelint",
    "fix:js": "eslint --fix --ext .ts,.js,.cjs,.mjs",
    "fix:prettier": "prettier --single-quote --write src/themes/elegant/scss",
    "fix:stylelint": "stylelint --fix src/themes/elegant/scss",

    "test:unit": "tools/phpunit-9.phar test/unit",
    "test:integration:74": "IT_HOST=wiki74.localhost tools/phpunit-9.phar test/integration",
    "test:integration:80": "IT_HOST=wiki80.localhost tools/phpunit-9.phar test/integration",
    "test:integration:81": "IT_HOST=wiki81.localhost tools/phpunit-9.phar test/integration",
    "test:integration:82": "IT_HOST=wiki82.localhost tools/phpunit-9.phar test/integration",
    "test:integration:83": "IT_HOST=wiki83.localhost tools/phpunit-9.phar test/integration",
    "test:integration:84": "IT_HOST=wiki84.localhost tools/phpunit-9.phar test/integration",
    "test:integration:85": "IT_HOST=wiki85.localhost tools/phpunit-9.phar test/integration"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "babelify": "10.0.0",
    "browserify": "17.0.1",
    "del": "8.0.1",
    "eslint": "9.38.0",
    "neostandard": "0.13.0",
    "globals": "17.4.0",
    "gulp": "5.0.1",
    "gulp-autoprefixer": "10.0.0",
    "gulp-concat": "2.6.1",
    "gulp-gzip": "1.4.2",
    "gulp-replace": "1.1.4",
    "gulp-sass": "6.0.1",
    "gulp-sort": "2.0.0",
    "gulp-tar": "5.0.0",
    "gulp-zip": "6.1.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.1",
    "sass": "1.98.0",
    "stylelint": "17.6.0",
    "stylelint-config-sass-guidelines": "13.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "vinyl-source-stream": "2.0.0"
  },
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "overrides": {
    "glob": "^13"
  },
  "bgColor": "#fefdfa"
}
